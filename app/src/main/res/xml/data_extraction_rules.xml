<?xml version="1.0" encoding="utf-8"?>
<!--
    Personal app holding only locally recorded audio and imported images.
    Nothing is backed up or transferred: the recordings are the user's own
    voice and there is no account to restore them against.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
