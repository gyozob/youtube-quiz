<?xml version="1.0" encoding="utf-8"?>
<!--
    The quiz overlay. Drawn in a TYPE_APPLICATION_OVERLAY window on top of
    YouTube, so it has no Activity and no window decorations of its own.
-->
<com.personal.youtubequiz.service.OverlayRootView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F00D0D0D"
    tools:theme="@style/Theme.YouTubeQuiz.Overlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/overlay_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/overlay_prompt"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Cards are added here in code: the row has to flip to a column in
             portrait, and the images come from the database. -->
        <LinearLayout
            android:id="@+id/overlay_choices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/overlay_replay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/replay_background"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="@string/overlay_replay"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Invisible safety valve. The overlay deliberately refuses to go away
         until the question is answered, which would be a trap if the content
         were ever broken; a deliberate long press in the corner releases it. -->
    <View
        android:id="@+id/overlay_escape"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/overlay_escape" />

</com.personal.youtubequiz.service.OverlayRootView>
