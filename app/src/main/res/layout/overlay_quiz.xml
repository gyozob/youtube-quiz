<?xml version="1.0" encoding="utf-8"?>
<!--
    The quiz overlay. Drawn in a TYPE_APPLICATION_OVERLAY window on top of
    YouTube, so it has no Activity and no window decorations of its own.
-->
<com.personal.youtubequiz.service.OverlayRootView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F00D0D0D"
    tools:theme="@style/Theme.YouTubeQuiz.Overlay">

    <!-- Cards are added here in code: the row has to flip to a column in
         portrait, and the images come from the database. -->
    <LinearLayout
        android:id="@+id/overlay_choices"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp" />

    <!-- Invisible safety valve. The overlay deliberately refuses to go away
         until the question is answered, which would be a trap if the content
         were ever broken; a deliberate long press in the corner releases it. -->
    <View
        android:id="@+id/overlay_escape"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/overlay_escape" />

    <!-- Practice mode only, and declared after the escape hatch so it sits on
         top of it; while it is gone the hatch owns the corner again. -->
    <TextView
        android:id="@+id/overlay_exit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/exit_background"
        android:clickable="true"
        android:contentDescription="@string/overlay_exit"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/overlay_exit_glyph"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

</com.personal.youtubequiz.service.OverlayRootView>
