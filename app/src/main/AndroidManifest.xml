<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draws the quiz overlay on top of YouTube. Granted manually via
         Settings > Display over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Recording questions and the two feedback sounds. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets the app deep-link the user to the battery-optimisation exemption
         screen, so the OS does not freeze the accessibility service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (Android 11+) so we can tell the user whether
         YouTube is actually installed. -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YouTubeQuiz">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Doubles as the foreground-app detector and the interval timer host.
             An accessibility service is kept alive by the system, which avoids
             needing a foreground service with a permanent notification. -->
        <service
            android:name=".service.YouTubeWatchService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
